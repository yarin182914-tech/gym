rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Site feedback is a shared board, not per-user data — any signed-in
    // user of the app may read every entry and add their own; editing an
    // existing entry (status/text) is also open to any signed-in user for
    // now, since this is a small internal tool, not multi-tenant content.
    match /siteFeedback/{feedbackId} {
      allow read, write: if request.auth != null;
    }
  }
}
